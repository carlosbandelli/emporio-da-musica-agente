# Copie para .env na raiz do projeto e preencha. Basta UMA chave de LLM para rodar: o roteador usa só os
# provedores que têm chave. Chaves vazias são ignoradas. A recomendada é GOOGLE_API_KEY (Gemini, plano grátis).
# Nunca faça commit do .env (ele está no .gitignore).

# --- Provedores de LLM (preencha ao menos uma) ---
# Recomendada: Google AI Studio (Gemini, plano grátis): https://aistudio.google.com/api-keys
GOOGLE_API_KEY=
# Opcional: Groq (classificador e nível simples). Sozinha, pode limitar turnos com tools (8 mil tokens/min no plano grátis).
# https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: Anthropic (Claude, nível complexo). Sem chave, o nível complexo usa Gemini. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Opcional: qualquer provedor compatível com a API da OpenAI (OpenAI, DeepSeek, OpenRouter, Ollama...) ---
# Basta nome, modelo e chave. Ele entra no FIM das cadeias de fallback; se for o único configurado, atende tudo.
#   LLM_PROVEDOR  nome livre (minúsculas, números, _ e -); aparece nos logs e métricas. Padrão: openai.
#                 Não pode ser claude, gemini nem groq (já são nativos): use, por exemplo, gemini-openai.
#   LLM_MODELO    obrigatório quando houver chave.
#   LLM_API_KEY   a chave do provedor. Ollama local não exige chave: use qualquer valor (ex.: ollama).
#   LLM_BASE_URL  opcional. Vazio = URL pronta do nome: openai, deepseek, openrouter, mistral, together, ollama.
#                 Qualquer outro nome exige LLM_BASE_URL.
# Exemplos (descomente UM bloco):
# OpenAI
# LLM_PROVEDOR=openai
# LLM_MODELO=gpt-4o-mini
# LLM_API_KEY=sk-...
# DeepSeek
# LLM_PROVEDOR=deepseek
# LLM_MODELO=deepseek-chat
# LLM_API_KEY=sk-...
# OpenRouter (o modelo leva o prefixo do fornecedor)
# LLM_PROVEDOR=openrouter
# LLM_MODELO=openai/gpt-4o-mini
# LLM_API_KEY=sk-or-...
# Ollama local (no Docker, use LLM_BASE_URL=http://host.docker.internal:11434/v1)
# LLM_PROVEDOR=ollama
# LLM_MODELO=qwen3:8b
# LLM_API_KEY=ollama
# Outro servidor compatível (vLLM, LM Studio, Gemini via endpoint OpenAI...): informe a URL base
# LLM_PROVEDOR=meu-vllm
# LLM_MODELO=nome-do-modelo
# LLM_API_KEY=qualquer
# LLM_BASE_URL=http://localhost:8000/v1

# --- Motor e dados ---
# Motor de atendimento. "nativo" é o padrão; "n8n" só existe na Fase 2.
MOTOR_ATENDIMENTO=nativo
# Simula a data de "hoje", com fuso (ex.: 2026-03-10T15:00:00-04:00). Os pedidos vão até 2026-03.
# Comentado = relógio real.
# DATA_REFERENCIA=2026-03-10T15:00:00-04:00
TENANTS_CONFIG=config/tenants.yaml
LOG_LEVEL=INFO

# --- Opcional: modelos e esforço (comentados = padrões do código) ---
# MODELO_GEMINI=gemini-2.5-flash
# MODELO_GROQ=openai/gpt-oss-120b
# ESFORCO_GROQ=low
# MODELO_CLAUDE=claude-opus-5-5
# ESFORCO_CLAUDE=low
# CLAUDE_FALLBACK_SERVIDOR=true

# --- Fase 2 (caminho 2: Docker Compose). O modo local (uv run emporio chat) não usa estas variáveis. ---
# O docker-compose sobrescreve os hosts com os nomes dos serviços internos.
DATABASE_URL=postgresql+psycopg://emporio:emporio@localhost:5432/emporio
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=emporio
# Gere um valor aleatório longo (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
# Observabilidade (opcional; vazio = desligado)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
APP_REPLICAS=3
# Só para TLS com Let's Encrypt em produção
ACME_EMAIL=
