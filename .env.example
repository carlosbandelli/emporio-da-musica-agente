# Copie para .env e preencha. Basta UMA chave de LLM para rodar (o roteador usa os provedores disponíveis).

# --- Provedores de LLM ---
# Google AI Studio: https://aistudio.google.com/api-keys
GOOGLE_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic (Claude): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Infraestrutura (o docker-compose sobrescreve com os hosts internos) ---
DATABASE_URL=postgresql+psycopg://emporio:emporio@localhost:5432/emporio
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=emporio

# --- Segurança ---
# Gere um valor aleatório longo (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=

# --- Observabilidade (opcional) ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=troque-esta-senha

# --- Aplicação ---
TENANTS_CONFIG=config/tenants.yaml
LOG_LEVEL=INFO
# Simula a data de "hoje" (AAAA-MM-DD) em testes e exemplos; vazio = relógio real
DATA_REFERENCIA=
APP_REPLICAS=3
# Só para TLS com Let's Encrypt em produção
ACME_EMAIL=
