    {
      "id": 11,
      "type": "stat",
      "title": "Estado do circuit breaker por provedor",
      "description": "0 = fechado, 1 = meio-aberto, 2 = aberto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (provedor) (emporio_circuito_estado)",
          "legendFormat": "{{provedor}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Fechado",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Meio-aberto",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Aberto",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      }
