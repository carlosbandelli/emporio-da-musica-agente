{
  "name": "Empório da Música - atendimento (AgenteN8n)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "emporio-atendimento",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c2d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "emporio-atendimento",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Empório - segredo do webhook"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.mensagem }}",
        "options": {
          "systemMessage": "={{ $json.body.sistema.cacheavel }}\n\n{{ $json.body.sistema.dinamico }}\n\nConversa até aqui (mais antiga primeiro):\n{{ $json.body.historico.map(m => (m.papel === 'user' ? 'Cliente: ' : 'Atendente: ') + m.texto).join('\n') || '(início da conversa)' }}",
          "maxIterations": 6,
          "returnIntermediateSteps": true
        }
      },
      "id": "a1f0c2d4-0002-4000-8000-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {}
      },
      "id": "a1f0c2d4-0003-4000-8000-000000000003",
      "name": "Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        160,
        260
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ texto: $json.output, tools_chamadas: ($json.intermediateSteps || []).map(p => ({ nome: p.action.tool, argumentos: p.action.toolInput, resultado: p.observation })), nivel: null, provedor: 'gemini' }) }}",
        "options": {}
      },
      "id": "a1f0c2d4-0004-4000-8000-000000000004",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        700,
        0
      ]
    },
    {
      "parameters": {
        "toolDescription": "Busca instrumentos no catálogo da loja por texto, categoria e/ou faixa de preço. Devolve preço vigente e disponibilidade calculados pela loja.",
        "method": "POST",
        "url": "={{ $('Webhook').first().json.body.tools.url_base }}/buscar_produtos",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Webhook').first().json.body.tools.token }}"
            },
            {
              "name": "X-Tenant-ID",
              "value": "={{ $('Webhook').first().json.body.tenant_id }}"
            },
            {
              "name": "Accept-Language",
              "value": "={{ $('Webhook').first().json.body.idioma }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ argumentos: $fromAI('argumentos', 'Objeto JSON com os argumentos da tool. Campos: texto (string); categoria (string); preco_min (number); preco_max (number)', 'json'), session_id: $('Webhook').first().json.body.sessao_id }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1f0c2d4-0100-4000-8000-000000000100",
      "name": "buscar_produtos",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        360,
        260
      ]
    },
